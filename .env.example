# Copy to `.env` and fill in. `.env` is gitignored.

# PostgreSQL connection string (Supabase, Neon, Railway, or local).
# Supabase: use the "Connection string" → URI (the pooled "Transaction" one,
# port 6543, with ?pgbouncer=true for serverless). Example shape:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL=

# Google Gemini API key (AI search / photo identify / catalogue translation).
GEMINI_API_KEY=
